+void
+loader_log_hex(const char *prefix, uint64_t value)
+{
+	static const char digits[] = "0123456789abcdef";
+	char line[64];
+	char *p = line;
+
+	while (*prefix != 0 && p < &line[40]) {
+		*p++ = *prefix++;
+	}
+	*p++ = '0';
+	*p++ = 'x';
+	for (int i = 15; i >= 0; i--) {
+		*p++ = digits[(value >> (i * 4)) & 0xf];
+	}
+	*p++ = '\n';
+	*p = 0;
+	loader_log_line(line);
+}
