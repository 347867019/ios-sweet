+# Device profile: sourced by common/build.sh and common/run.sh. Copy with common/new-device.sh.
+# Everything here is plain shell variables; see docs/PORTING.md for where each value comes from.
+
+NAME="OnePlus 6 (enchilada)"
+KIND=phone                      # phone | qemu
+SOC="Qualcomm Snapdragon 845 (SDM845 v2.1)"
+
+# --- boot chain (phones) ---------------------------------------------------------------------------
+# The phone boots a Mu-Silicium UEFI (Project Silicium) with `fastboot boot`; the UEFI starts our loader.
+UEFI_TARGET=enchilada
+UEFI_FD=                        # built SILICIUM_UEFI.fd with the XnuLoader hook: Mu-Silicium/Build/enchiladaPkg/...
+                                # (official v4.0 prebuilt fd, NO hook: /data/uefi/SILICIUM_UEFI.fd -- smoke test only)
+DTB=/home/oxjmo/oneplus_ios_sweet/op6/backup/op6-20261023-151102/dtb/fdt.bin
+FD_BASE=0x9FC00000              # official v4.0 BootShim.bin disasm: mov x5,#0x9fc00000 (redwood is 0x9FD00000!)
+FD_SIZE=0x300000                # official enchilada v4.0 fd is 3 MiB (redwood is 0x200000)
+PAYLOAD_BASE=0xF0000000         # where the kernel + images container goes (free RAM in the memory map)
+
+# --- kernel and loader -----------------------------------------------------------------------------
+# xnuloader/loader.c picks its `struct platform` by what the firmware reports (see docs/PORTING.md):
+# a new SoC needs one there (common/new-device.sh writes a starting point next to this file).
+FB_BASE=0x9D400000              # the GOP base the UEFI printed on first boot ("display 1080 x 2280 at 9d400000");
+                                # the DTB's cont_splash_region@9d400000, same value (2026-10-24 real device)
+WIFI_ATH11K=1                   # WCN3990, integrated on PCIe (ath11k supports it)
+
+# --- what the run needs ----------------------------------------------------------------------------
+BOOTARGS="touchscreen=1 cpufreq=1 bootcpu=7 cpus=8"   # 4x Gold + 4x Silver, all Cortex-A75 (small=0x0)
+DEFAULT_SECS=900
+USERLAND_VARS=""                # extra variables for userland/build.sh, e.g. "GL=1"
+# The phone's own firmware, taken from its Android (never in the repository): see docs/PORTING.md.
+FIRMWARE="fw-gpu fw-wifi fw-audio fw-haptic"   # from /vendor/firmware_mnt via adb
+
+# --- hardware reference (from the live FDT, capture 2026-10-23, see op6/backup/op6-20261023-151102) ---
+# panel: Samsung SOFEF00 cmd mode 1080x2280 (dsi_samsung_sofef00_m_cmd, dtbo_idx=5, panel_type=black)
+# touch: Synaptics S3320 (RMI4) on GENI I2C @0xa90000, addr 0x20, IRQ pm8998 gpio125, coords 1080x2160
+# UFS:   ufshc @0x1d84000, IRQ SPI 265, QMP v3 PHY, 2 lanes (same family as sweet -- sweet_ufs.c)
+# USB:   dwc3 @0xa600000 (ssusb, ahb2phy 0x88ee000)
+# PMIC:  PM8998 on SPMI @0xc440000 (keys home/vol_up/cam); debug uart: GENI QUP @0xa84000
+# GPU:   Adreno 630 (gpucc/gfxcc @0x5090000); timer 19.2 MHz, standard ARMv8 PPIs
+# RAM:   8GB LPDDR4X, bank0 0x80000000+4G, bank1 0x180000000+0xfc8a0000; big free RAM 0x97d00000-0x27c89ffff
+#        (carve-outs to avoid: 0x85700000-0x8c416000) -- FD_BASE/PAYLOAD_BASE above land in free RAM
