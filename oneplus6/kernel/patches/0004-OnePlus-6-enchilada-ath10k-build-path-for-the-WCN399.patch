+static struct ath10k *driver;				/* (the radio the driver has taken up) */
+
+/* lx_prepare(): the memory the radio is shown: once. 0, or an errno. */
+int
+lx_prepare(void)
+{
+
+	return (lx_base_init() != 0 || lx_pool_init() != 0 ? ENOMEM : 0);
+}
+
+int
+lx_start(void)
+{
+	struct platform_device *pdev = &radio_platform_device;
+	struct device *dev = &pdev->dev;
+	struct ath10k *ar;
+	unsigned long long began, now;
+	int ret;
+
+	ath10k_debug_mask = lx_os_option("wifi_debug");
+
+	/*
+	 * The device the driver's probe is given: the radio's node and its resources, and
+	 * nothing else of what Linux would have built around it.
+	 */
+	memset(pdev, 0, sizeof(*pdev));
+	pdev->name = "wcn3990-wifi";
+	pdev->id = -1;
+	pdev->resource = radio_resources;
+	pdev->num_resources = sizeof(radio_resources) / sizeof(radio_resources[0]);
+	dev->of_node = &radio_node;
+	dev->driver_data = NULL;
+
+	/*
+	 * The driver's own file has said itself as a driver; its probe is given the device the
+	 * way the bus would have. From it, ath10k's core takes the radio up with it: its copy
+	 * engines, its QMI, and its firmware -- and the driver's threads carry it from here, to
+	 * the flag core.c sets when it has been through its start. The radio is up if the flag
+	 * is there within the minute.
+	 */
+	if (radio_driver == NULL || radio_driver->probe == NULL) {
+		says("the driver has not said itself as a driver\n");
+		return (EIO);
+	}
+	began = lx_os_nanoseconds();
+	if ((ret = (radio_driver->probe)(dev)) != 0) {
+		says("the driver's probe would not have the radio: %d\n", ret);
+		devres_release_all();
+		return (-ret);
+	}
+	ar = dev_get_drvdata(dev);
+	says("%llu ms after its probe the driver is working on the radio\n",
+	    (lx_os_nanoseconds() - began) / 1000000ull);
+
+	while (ar != NULL && !test_bit(ATH10K_FLAG_CORE_REGISTERED, &ar->dev_flags) &&
+	    lx_os_nanoseconds() - began < 60000000000ull) {
+		lx_pause_ms(10);
+	}
+	now = lx_os_nanoseconds();
+	if (ar == NULL || !test_bit(ATH10K_FLAG_CORE_REGISTERED, &ar->dev_flags)) {
+		says("%llu ms after its start the driver HAS NOT GOT THROUGH %s\n", (now - began) / 1000000ull,
+		    ar != NULL ? "its start: what it says is in the log" : "(it gave the radio back)");
+		lx_stop();
+		return (EIO);
+	}
+	says("%llu ms after its start the radio IS UP as far as it is built\n", (now - began) / 1000000ull);
+	lx_pause_ms(1000);				/* (for what the firmware says unasked once it is ready) */
+
+	driver = ar;
+	if (lx_os_option("wifi_station")) {
+		/* whoever wants a network asks the kernel, and the kernel asks the station: the driver stays up until lx_stop() */
+		if ((ret = lx_station_offer()) == 0) {
+			return (0);
+		}
+	} else if (lx_os_option("wifi_join")) {
+		if ((ret = lx_station_join()) == 0) {
+			if (lx_os_option("wifi_hold")) {	/* (seconds to stay before returning: to see frames pass) */
+				lx_pause_ms(1000 * lx_os_option("wifi_hold"));
+				lx_station_say();
+			}
+			return (0);			/* the network is joined, and the driver stays up until lx_stop() */
+		}
+	} else {
+		ret = lx_os_option("wifi_scan") ? lx_station_scan() : 0;
+	}
+	lx_stop();
+	return (ret);
+}
+
+/* The network left, and the driver down as its own removal does it (its devres is let go of there). */
+void
+lx_stop(void)
+{
+	struct ath10k *ar = driver;
+
+	if (ar == NULL) {
+		return;
+	}
+	driver = NULL;
+	lx_station_withdraw();
+	lx_station_leave();
+	if (radio_driver != NULL && radio_driver->remove != NULL) {
+		(radio_driver->remove)(&radio_platform_device);	/* (its own removal) */
+	}
+	devres_release_all();
+	says("the driver is down again\n");
+}
+
+int
+lx_transmit(const unsigned char *frame, unsigned long length)
+{
+
+	return (driver != NULL ? lx_station_send(frame, length) : ENETDOWN);
+}
