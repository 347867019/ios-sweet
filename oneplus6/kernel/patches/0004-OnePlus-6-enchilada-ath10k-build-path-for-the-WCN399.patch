+struct resource *platform_get_resource_byname(struct platform_device *pdev, unsigned type,
+    const char *name);
+int platform_get_irq(struct platform_device *pdev, unsigned num);
+void platform_set_drvdata(struct platform_device *pdev, void *data);
+void *platform_get_drvdata(struct platform_device *pdev);
+
+static inline int
+platform_driver_probe(struct platform_driver *pdrv,
+    int (*pd_probe_f)(struct platform_device *))
+{
+
+	return (0);
+}
+
+static inline int
+platform_device_register(struct platform_device *pdev)
+{
+
+	return (0);
+}
+
+static inline void
+platform_device_unregister(struct platform_device *pdev)
+{
+}
+
+static inline void *
+dev_get_platdata(struct device *dev)
+{
+
+	return (NULL);
+}
+
+/* The driver of such a device, as its own file says it: its registration keeps the driver where
+ * lx_ath10k.c takes it from, to give its probe the device. */
+#define	module_platform_driver(_drv)					\
+	int _drv##_register_(void)					\
