+/*
+ * FreeBSD's own names, which LinuxKPI's headers say where the driver reaches the paths of theirs
+ * ours does not cover: the waiting of Linux (taken as a sleep, for the driver runs on threads
+ * only), the sleep of FreeBSD's slice of a second, and the saying of a message against a device
+ * (there is no name of a device to say here, so the message alone is said).
+ */
+void
+DELAY(int usec)
+{
+	static char nothing;
+
+	lx_os_lock();
+	lx_os_sleep(&nothing, (unsigned long long)usec * 1000ull);
+	lx_os_unlock();
+}
+
+int
+pause_sbt(const char *what, sbintime_t sbt, sbintime_t pri, int flags)
+{
+	static char nothing;
+
+	(void)what;
+	(void)pri;
+	(void)flags;
+	lx_os_lock();
+	lx_os_sleep(&nothing, ((unsigned long long)sbt * 1000000000ull) >> 32);
+	lx_os_unlock();
+	return (0);
+}
