+/* ---- the driver's interrupts ------------------------------------------------------------------- */
+/*
+ * What the driver asks for its copy engines' interrupts, on the kernel's vectors: a handler is
+ * taken on masked, is let in with enable_irq() where the driver turns an engine's own on, and is
+ * quieted with disable_irq() (which returns when no run of it is under way).
+ */
+#define RADIO_IRQ_COUNT		CE_COUNT_MAX
+
+static irq_handler_t radio_irq_handler[RADIO_IRQ_COUNT];
+static void *radio_irq_argument[RADIO_IRQ_COUNT];
+
+static void
+radio_irq(void *argument)
+{
+	unsigned vector = (unsigned)(uintptr_t)argument;
+
+	if (vector < RADIO_IRQ_COUNT && radio_irq_handler[vector] != NULL) {
+		(radio_irq_handler[vector])((int)vector, radio_irq_argument[vector]);
+	}
+}
+
+int
+lkpi_request_irq(struct device *dev, unsigned int irq, irq_handler_t handler,
+    irq_handler_t thread_handler, unsigned long flags, const char *name, void *argument)
+{
+
+	if (irq >= RADIO_IRQ_COUNT || handler == NULL) {
+		return (-EINVAL);
+	}
+	if (lx_os_irq_attach(irq, radio_irq, (void *)(uintptr_t)irq) != 0) {
+		return (-EINVAL);
+	}
+	radio_irq_handler[irq] = handler;
+	radio_irq_argument[irq] = argument;
+	return (0);
+}
+
+void
+lkpi_free_irq(unsigned int irq, void *argument)
+{
+
+	if (irq < RADIO_IRQ_COUNT) {
+		radio_irq_handler[irq] = NULL;
+		radio_irq_argument[irq] = NULL;
+		lx_os_irq_disable(irq);
+	}
+}
