+	const char *name;
+	u64 dma_mask;
+};
+
+struct platform_device *platform_device_register_full(struct platform_device_info *info);
+
+#define	dev_is_platform(_dev)	(false)
+#define	to_platform_device(_dev)	container_of(_dev, struct platform_device, dev)
+
