diff --git a/tools/mk-ath10k.sh b/tools/mk-ath10k.sh
new file mode 100755
index 0000000..a047386
--- /dev/null
+++ b/tools/mk-ath10k.sh
@@ -0,0 +1,211 @@
+#!/bin/bash
+# Build the driver of the OnePlus 6's Wi-Fi radio for our kernel: ath10k, Qualcomm's driver for
+# the WCN3990 as it is in Linux, unmodified, on a layer that gives it the kernel interfaces it
+# expects. Three things meet here, and only the third is in the repository:
+#
+#   Linux's ath10k        drivers/net/wireless/ath/ath10k of a pinned release of Linux (ISC);
+#   FreeBSD's LinuxKPI    the headers with which FreeBSD compiles Linux drivers, with the kernel
+#                         headers those are written against (BSD-2-Clause, of a pinned release
+#                         of FreeBSD); patched with wifi/lx/patches/*.patch. Its source files
+#                         are not used: what they do is done in wifi/lx/src;
+#   wifi/lx               ours: the headers LinuxKPI lacks (device tree, platform devices, the
+#                         radio's supplies and clocks, its SMMU), and the functions underneath
+#                         (locks, sleeping, work, memory, firmware, the radio's bus) written on
+#                         the handful of calls that the kernel's bsd/dev/redwood_lx.c offers
+#                         (bsd/sys/redwood_lx.h of the kernel tree). src/lx_ath10k.c is what
+#                         stands in the driver's place of snoc.c's platform device, as lx_bus.c
+#                         stood in ath11k's place of ahb.c; the rest of the layer is shared.
+#
+# Not all of the driver is built yet: DRIVER below lists the files that are. What they call in
+# the files that are not becomes a function that says its name in the log and answers 0
+# (out/stubs.txt lists them), unless wifi/lx/src has one that does more. The radio sits on the
+# SoC's network (SNOC), not on PCIe, so the driver's pci.c, ahb.c, sdio.c and usb.c stay out;
+# snoc.c, the bus it does have, is in. Its debug.c stays out too: src/lx_ath10k.c says what it
+# would (ath10k_dbg and its kind), as lx_bus.c does for ath11k's.
+#
+# Everything is compiled as FreeBSD kernel code for an Apple arm64 kernel and tied into one
+# object that shows nothing but its entry points; the kernel links it when it is there
+# (xnu-build.sh reads xnu-deps/build/ath10k/out/ath10k.o when REDWOOD_WIFI=ath10k).
+#
+#   VERSION   of Linux. 7.0.14, the release LinuxKPI's 802.11 headers follow; for the WCN3990
+#             the driver asks the same of firmware and platform as in the 6.6 series.
+#   FREEBSD   15.1-RELEASE, the first release whose LinuxKPI is at Linux 7.0.
+#
+# What comes out, in xnu-deps/build/ath10k:
+#   src/ath10k/        the driver's files, untouched       freebsd/sys/   FreeBSD's, patched
+#   out/ath10k.o       the object for the kernel           out/stubs.txt  what is not there yet
+# Needs on this machine: curl, tar, xz, sha256sum, patch, awk, clang, and the kernel's linker
+# (xnu-deps/host/bin/ld64, see xnu-deps/setup.sh). The two archives are 150 and 253 MB and are
+# kept; the Linux one is shared with tools/mk-ath11k.sh by way of a link made here.
+#
+# usage: tools/mk-ath10k.sh [fetch]        "fetch" stops when the driver's sources are there
+set -e
+# the tools this runs pick up a wrong liblzma otherwise, and cannot unpack with it
+unset LD_LIBRARY_PATH LD_PRELOAD
+VERSION=7.0.14
+SHA256=de9999b784d2293f00d39c62d8f92a08ab8a54bc4e80ffd250a0c09cb07a0f98
+ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
+B=$ROOT/xnu-deps/build/ath10k
+ATH=drivers/net/wireless/ath
+mkdir -p "$B"
+cd "$B"
+# one Linux tree serves both drivers: take the archive from mk-ath11k.sh's directory when it has it
+[ -f linux-$VERSION.tar.xz ] || ln -s ../ath11k/linux-$VERSION.tar.xz linux-$VERSION.tar.xz
+
+if [ "$(cat src/.release 2>/dev/null)" != "$VERSION $SHA256" ]; then
+	[ -f linux-$VERSION.tar.xz ] || curl -sL --fail -o linux-$VERSION.tar.xz \
+		https://cdn.kernel.org/pub/linux/kernel/v${VERSION%%.*}.x/linux-$VERSION.tar.xz
+	echo "$SHA256  linux-$VERSION.tar.xz" | sha256sum -c --quiet
+	rm -rf src unpacked
+	mkdir unpacked
+	tar xJf linux-$VERSION.tar.xz -C unpacked --strip-components=1 linux-$VERSION/$ATH/ath10k \
+		linux-$VERSION/$ATH/ath.h linux-$VERSION/$ATH/regd.h linux-$VERSION/$ATH/regd.c \
+		linux-$VERSION/$ATH/regd_common.h linux-$VERSION/$ATH/dfs_pattern_detector.h \
+		linux-$VERSION/$ATH/spectral_common.h
+	# every file must say itself that it may be used so: the licence is checked, not assumed.
+	# ath10k's files carry the ISC as an SPDX tag alone, where ath11k's spell it out.
+	for f in unpacked/$ATH/ath10k/*.[ch] unpacked/$ATH/ath.h unpacked/$ATH/regd.h \
+		unpacked/$ATH/regd.c unpacked/$ATH/regd_common.h unpacked/$ATH/dfs_pattern_detector.h \
+		unpacked/$ATH/spectral_common.h; do
+		case "$(head -6 "$f")" in
+		*"SPDX-License-Identifier: BSD-3-Clause-Clear"*) ;;
+		*"SPDX-License-Identifier: ISC"*) ;;
+		*"Permission to use, copy, modify, and/or distribute this software"*) ;;      # (ISC, spelt out)
+		*) echo "mk-ath10k.sh: $f does not carry the licence expected" >&2; exit 1 ;;
+		esac
+	done
+	mkdir src
+	mv unpacked/$ATH/ath10k src/ath10k
+	mv unpacked/$ATH/ath.h unpacked/$ATH/regd.h unpacked/$ATH/regd.c \
+		unpacked/$ATH/regd_common.h unpacked/$ATH/dfs_pattern_detector.h \
+		unpacked/$ATH/spectral_common.h src/
+	rm -rf unpacked
+	echo "$VERSION $SHA256" > src/.release
+fi
+[ "$1" = fetch ] && { echo "mk-ath10k.sh: ath10k of Linux $VERSION: $B/src/ath10k"; exit 0; }
+W=$ROOT/wifi/lx
+
+# --- FreeBSD's LinuxKPI and the kernel headers under it, with our patches on top. When the patches
+# change, the tree is taken from the archive again (as tools/mk-mesa.sh does with Mesa's).
+FREEBSD=15.1
+FREEBSD_SHA256=cf5762da53fd52e1eaf0f9ceee9bf58cbe314c821031d0d9ffa76823185a89e1
+FSYS="compat/linuxkpi sys arm64/include net net80211 netinet netinet6 vm kern tools libkern ddb
+	security fs/pseudofs crypto opencrypto geom bsm isa cam rpc xdr x86/include ofed/include
+	dev/pci dev/ofw dev/fdt dev/acpica dev/usb dev/iicbus dev/backlight
+	contrib/ck/include contrib/dev/acpica/include contrib/libnv"
+PATCHES=$(cat "$W"/patches/*.patch 2>/dev/null | sha256sum | cut -d' ' -f1)
+if [ "$(cat freebsd/.release 2>/dev/null)" != "$FREEBSD $FREEBSD_SHA256 $PATCHES" ]; then
+	[ -f freebsd-$FREEBSD-src.txz ] || curl -sL --fail -o freebsd-$FREEBSD-src.txz \
+		https://download.freebsd.org/releases/amd64/$FREEBSD-RELEASE/src.txz
+	echo "$FREEBSD_SHA256  freebsd-$FREEBSD-src.txz" | sha256sum -c --quiet
+	rm -rf freebsd gen obj
+	mkdir freebsd
+	tar xJf freebsd-$FREEBSD-src.txz -C freebsd --strip-components=2 usr/src/COPYRIGHT \
+		$(for d in $FSYS; do echo usr/src/sys/$d; done)
+	for p in "$W"/patches/*.patch; do
+		[ -f "$p" ] && patch -s --no-backup-if-mismatch -d freebsd -p1 < "$p"
+	done
+	echo "$FREEBSD $FREEBSD_SHA256 $PATCHES" > freebsd/.release
+fi
+S=$B/freebsd/sys
+
+# --- what FreeBSD's build would have generated: the interfaces of its device framework, and the
+# option headers, which here say only that there is an Internet
+if [ ! -d gen ]; then
+	mkdir gen
+	(
+		cd gen
+		ln -s $S/arm64/include machine
+		for m in kern/device_if.m kern/bus_if.m dev/pci/pci_if.m dev/pci/pci_iov_if.m dev/pci/pcib_if.m \
+			dev/iicbus/iicbus_if.m dev/iicbus/iicbb_if.m dev/backlight/backlight_if.m dev/usb/usb_if.m \
+			dev/ofw/ofw_bus_if.m; do
+			awk -f $S/tools/makeobjops.awk $S/$m -h
+		done
+		for o in h p q; do awk -f $S/tools/vnode_if.awk $S/kern/vnode_if.src -$o; done
+		for o in $(grep -rhoE "opt_[a-z0-9_]+\.h" $S | sort -u) lkpi_iic_if.h; do : > $o; done
+		printf '#define INET 1\n#define INET6 1\n' > opt_inet.h
+		printf '#define INET6 1\n' > opt_inet6.h
+		printf '#define SMP 1\n' > opt_global.h
+	)
+fi
+
+# --- compile: the driver's files that are built so far, and ours. lx_bus.c stays out: it is
+# ath11k's bus stand-in (WCN6750 on AHB); ath10k's own snoc.c is in, and lx_ath10k.c is what
+# stands where its platform device would be. coredump.c stays out: what its parts not built would
+# give the kernel's crash report is had from the driver's own log for now.
+DRIVER="core snoc qmi qmi_wlfw_v01 htc wmi wmi-tlv ce mac htt htt_rx htt_tx txrx bmi hw swap
+	p2p"
+SHARED="regd"		# the ath/ files the driver shares (src/regd.c)
+OURS="lx_base lx_80211 lx_wpa lx_ath10k"
+CC="clang -target arm64-apple-ios16.5"
+LD=$ROOT/xnu-deps/host/bin/ld64
+CFLAGS="-mkernel -mgeneral-regs-only -fno-builtin -fno-common -ffreestanding -fno-strict-aliasing
+	-funsigned-char -nostdinc -std=gnu17 -O2 -g -w
+	-D__FreeBSD__=15 -D_KERNEL -DKLD_MODULE -DHAVE_KERNEL_OPTION_HEADERS -include opt_global.h
+	-I$W/include -Igen -I$S -I$S/contrib/ck/include
+	-I$S/compat/linuxkpi/common/include -I$S/compat/linuxkpi/dummy/include
+	-include $S/compat/linuxkpi/common/include/linux/kconfig.h -DLINUXKPI_VERSION=70000"
+DFLAGS="-Isrc/ath10k -Isrc -include $W/include/lx_prelude.h -DCONFIG_ATH10K_DEBUG
+	-DKBUILD_MODNAME=\"ath10k\""
+# two headers are the kernel's: what it offers this object (wifi/lx/include/lx_os.h), and its QMI
+# helpers (wifi/lx/include/linux/soc/qcom/qmi.h)
+source "$ROOT/xnu-env.sh"
+for h in lx qmi; do
+	[ -f "$XNU_SRC/bsd/sys/redwood_$h.h" ] || { echo "mk-ath10k.sh: the kernel tree has no bsd/sys/redwood_$h.h" >&2; exit 1; }
+done
+DFLAGS="$DFLAGS -DLX_REDWOOD_LX_H=\"$XNU_SRC/bsd/sys/redwood_lx.h\" -DLX_REDWOOD_QMI_H=\"$XNU_SRC/bsd/sys/redwood_qmi.h\""
+mkdir -p obj out
+rm -f obj/*.err
+compile() {		# compile SOURCE OBJECT [FLAGS]: only when the object is older than anything it was made of
+	local src=$1 obj=$2
+	shift 2
+	if [ -f "$obj" ] && [ -f "$obj.d" ] && [ -z "$(find $(sed -e 's/^[^:]*://' -e 's/\\$//' "$obj.d") "$0" -newer "$obj" 2>/dev/null | head -1)" ]; then
+		return
+	fi
+	$CC $CFLAGS "$@" -MMD -MF "$obj.d" -c "$src" -o "$obj" 2> "$obj.err" || rm -f "$obj"
+}
+for f in $DRIVER; do compile src/ath10k/$f.c obj/ath10k_$f.o $DFLAGS & done
+for f in $SHARED; do compile src/$f.c obj/ath10k_$f.o $DFLAGS -Isrc -I$S/net80211 & done
+for f in $OURS; do compile "$W/src/$f.c" obj/$f.o $DFLAGS -I$W/src & done
+wait
+bad=
+for f in obj/*.err; do
+	[ -s "$f" ] && [ ! -f "${f%.err}" ] && { echo "--- $(basename "$f" .o.err)"; grep -m6 -A3 "error:" "$f"; bad=1; }
+done
+[ -z "$bad" ] || exit 1
+OBJECTS=$(for f in $DRIVER $SHARED; do echo obj/ath10k_$f.o; done; for f in $OURS; do echo obj/$f.o; done)
+
+# --- tie it all into one object. What it then still wants is one of three things: a call of the
+# kernel's (redwood_lx.h; the QMI helpers; the handful of C library functions XNU has under the same
+# names with the same meaning), a function of a part of the driver that is not built yet, or a
+# mistake. The second kind gets a stub each that says its name and answers 0; anything else
+# missing ends the build.
+KERNEL="memcmp memcpy memmove memset strcmp strncmp strlen strchr strrchr strlcpy strlcat bzero
+	snprintf vsnprintf __stack_chk_fail __stack_chk_guard
+	device_printf DELAY pause_sbt nanouptime"
+$LD -r -arch arm64 $OBJECTS -o out/all.o 2> out/ld.err || { cat out/ld.err; exit 1; }
+llvm-nm -u --format=just-symbols out/all.o | sed 's/^_//' | sort > out/undefined.txt
+: > out/stubs.txt
+: > out/stubs.s
+missing=
+for s in $(cat out/undefined.txt); do
+	case " $(echo $KERNEL) " in *" $s "*) continue ;; esac
+	case $s in
+	lx_os_*|qmi_*|redwood_qmi_*|section\$*) continue ;;
+	ath10k_*|__ath10k_*) ;;
+	*) echo "mk-ath10k.sh: nothing defines $s" >&2; missing=1; continue ;;
+	esac
+	echo $s >> out/stubs.txt
+	printf '\t.globl _%s\n_%s:\n\tadrp x0, 1f@PAGE\n\tadd x0, x0, 1f@PAGEOFF\n\tb _lx_stub\n\t.cstring\n1:\t.asciz "%s"\n\t.text\n\t.p2align 2\n' \
+		$s $s $s >> out/stubs.s
+done
+[ -z "$missing" ] || exit 1
+$CC -c out/stubs.s -o out/stubs.o
+# four names are shown: where the kernel enters (lx_prepare(), lx_start(), lx_stop() and lx_transmit() of redwood_lx.h)
+printf '_lx_prepare\n_lx_start\n_lx_stop\n_lx_transmit\n' > out/exported.txt
+$LD -r -arch arm64 -exported_symbols_list out/exported.txt out/all.o out/stubs.o -o out/ath10k.o 2> out/ld.err ||
+	{ cat out/ld.err; exit 1; }
+rm -f out/all.o
+echo "mk-ath10k.sh: out/ath10k.o: $(llvm-size out/ath10k.o | awk 'NR == 2 { print $1 + $2 }') bytes of code and data from" \
+	"$(echo $DRIVER | wc -w) of the driver's files; $(wc -l < out/stubs.txt) functions of the others are stubs (out/stubs.txt);" \
+	"asks the kernel for $(llvm-nm -u --format=just-symbols out/ath10k.o | grep -vc 'section\$') names"
diff --git a/tools/mk-ath11k.sh b/tools/mk-ath11k.sh
index f06a33b..8b88ec9 100755
--- a/tools/mk-ath11k.sh
+++ b/tools/mk-ath11k.sh
@@ -67,6 +67,26 @@ if [ "$(cat src/.release 2>/dev/null)" != "$VERSION $SHA256" ]; then
 	echo "$VERSION $SHA256" > src/.release
 fi
 [ "$1" = fetch ] && { echo "mk-ath11k.sh: ath11k of Linux $VERSION: $B/src/ath11k"; exit 0; }
+
+# --- MHI (drivers/bus/mhi/host of the same Linux tree): the bus the radio's firmware is carried
+# over, when the radio sits on PCIe as the OnePlus 6's WCN3990 does (ath11k's pci.c is written
+# against it). GPL-2.0: its own licence track, checked separately here, and built only when the
+# PCI path of the driver is (a later step of the port). The same archive is the source.
+if [ "$(cat src/.mhi_release 2>/dev/null)" != "$VERSION $SHA256" ]; then
+	rm -rf src/mhi
+	mkdir -p src/mhi/include
+	tar xJf linux-$VERSION.tar.xz -C src/mhi --strip-components=4 linux-$VERSION/drivers/bus/mhi/host
+	tar xJf linux-$VERSION.tar.xz -C src/mhi/include --strip-components=2 linux-$VERSION/include/linux/mhi.h
+	# every file must say itself that it may be used so: the licence is checked, not assumed
+	for f in src/mhi/host/*.c src/mhi/host/*.h src/mhi/include/linux/mhi.h; do
+		case "$(head -4 "$f")" in
+		*"GPL-2.0"*) ;;
+		*) echo "mk-ath11k.sh: $f does not carry the licence expected (GPL-2.0)" >&2; exit 1 ;;
+		esac
+	done
+	echo "$VERSION $SHA256" > src/.mhi_release
+fi
+[ "$1" = mhi ] && { echo "mk-ath11k.sh: MHI host of Linux $VERSION: $B/src/mhi/host"; exit 0; }
 W=$ROOT/wifi/lx
 
 # --- FreeBSD's LinuxKPI and the kernel headers under it, with our patches on top. When the patches
diff --git a/wifi/lx/include/linux/clk.h b/wifi/lx/include/linux/clk.h
new file mode 100644
index 0000000..32b94bf
--- /dev/null
+++ b/wifi/lx/include/linux/clk.h
@@ -0,0 +1,35 @@
+/* The radio's clocks, as drivers ask for them. There is no clock framework under XNU: what a
+ * clock is, and what gating it means, is in src/lx_ath10k.c, from what the machine says. */
+#ifndef _LX_LINUX_CLK_H
+#define _LX_LINUX_CLK_H
+
+#include <linux/device.h>
+
+struct clk;
+
+struct clk_bulk_data {
+	const char *id;
+	struct clk *clk;
+};
+
+struct clk *clk_get(struct device *dev, const char *id);
+void clk_put(struct clk *clk);
+int clk_prepare_enable(struct clk *clk);
+void clk_disable_unprepare(struct clk *clk);
+unsigned long clk_get_rate(struct clk *clk);
+
+int clk_bulk_get(struct device *dev, int count, struct clk_bulk_data *clks);
+void clk_bulk_put(int count, struct clk_bulk_data *clks);
+int clk_bulk_prepare_enable(int count, struct clk_bulk_data *clks);
+void clk_bulk_disable_unprepare(int count, struct clk_bulk_data *clks);
+
+struct clk *devm_clk_get(struct device *dev, const char *id);
+struct clk *devm_clk_get_optional(struct device *dev, const char *id);
+int devm_clk_bulk_get_optional(struct device *dev, int count, struct clk_bulk_data *clks);
+
+static inline int clk_prepare(struct clk *clk) { return (0); }
+static inline void clk_unprepare(struct clk *clk) { }
+static inline int clk_enable(struct clk *clk) { return (0); }
+static inline void clk_disable(struct clk *clk) { }
+
+#endif
diff --git a/wifi/lx/include/linux/firmware/qcom/qcom_scm.h b/wifi/lx/include/linux/firmware/qcom/qcom_scm.h
new file mode 100644
index 0000000..59b38e0
--- /dev/null
+++ b/wifi/lx/include/linux/firmware/qcom/qcom_scm.h
@@ -0,0 +1,26 @@
+/* What the driver asks the machine's secure monitor (TrustZone) for. Only what ath10k's QMI
+ * needs: the handing over of a span of memory to the processors that will use it. The ask
+ * itself goes through the kernel (it is lx_os_scm_assign() of redwood_lx.h). */
+#ifndef _LX_LINUX_FIRMWARE_QCOM_QCOM_SCM_H
+#define _LX_LINUX_FIRMWARE_QCOM_QCOM_SCM_H
+
+#include <linux/types.h>
+
+/* (the identities, as the machine's table has them: 0x3, 0xf, 0x18, 0x19; the rights to read
+ * and to write, 4 and 2, are one each of a bit more) */
+#define QCOM_SCM_VMID_HLOS		3		/* 0x3: this system */
+#define QCOM_SCM_VMID_MSS_MSA		15		/* 0xf: the modem's */
+#define QCOM_SCM_VMID_WLAN		24		/* 0x18: the WLAN's */
+#define QCOM_SCM_VMID_WLAN_CE		25		/* 0x19: the WLAN's copy engines' */
+
+#define QCOM_SCM_PERM_RW		6		/* to read (4) and to write (2) */
+
+struct qcom_scm_vmperm {
+	unsigned int vmid;
+	unsigned int perm;
+};
+
+int qcom_scm_assign_mem(unsigned long long addr, unsigned long long size,
