diff --git a/wifi/lx/src/lx_ath10k.c b/wifi/lx/src/lx_ath10k.c
new file mode 100644
index 0000000..b2b63b4
--- /dev/null
+++ b/wifi/lx/src/lx_ath10k.c
@@ -0,0 +1,1315 @@
+/*
+ * The radio's machine, for ath10k: what stands between the driver and this phone's WCN3990 where
+ * its own bus (snoc.c) asks the machine what is there. snoc.c runs its probe here on a device we
+ * say -- the one the machine's own table would have had for the radio ("wlan@18800000", with its
+ * registers and its eleven interrupts) -- and everything the driver asks of the parts of Linux
+ * that are not there is answered from what this phone is.
+ *
+ * There is no device tree under XNU, and none of Linux's framework of supplies, clocks and
+ * firmware tables: the radio is made ready by the kernel before the driver starts (its supplies
+ * and its clocks are the kernel's to mind; lx_os_rproc_boot() is the modem's coming up), so the
+ * driver's questions about its regulators, its clocks and its power sequence are answered "it is
+ * so", and its firmware comes from where lx_os_firmware() reads. What it asks of the machine's
+ * secure monitor -- the handing over of a span of memory to the modem, that the firmware may be
+ * worked in it -- goes through the kernel (lx_os_scm_assign() of redwood_lx.h): TrustZone is
+ * asked, and what it says is said in the log.
+ *
+ * Its interrupts are the kernel's vectors: the driver's handler for a copy engine runs there,
+ * masked to begin with, as the driver itself asks for (IRQF_NO_AUTOEN), and is quieted where the
+ * driver asks for it. The driver's memory that lives as long as its device does is kept in
+ * Linux's way of it: a head of a few words before the memory, and the device a list of them,
+ * taken down when lx_stop() takes the driver down.
+ *
+ * Where this stage ends: snoc.c has made the radio's memory and its copy engines known to the
+ * driver and has started its QMI, qmi.c has had its exchange with the firmware through the
+ * modem's service (the firmware in MSA memory, granted to the modem by the machine's monitor),
+ * core.c has started the firmware in mission mode and htc.c, wmi.c and mac.c have been through
+ * what they are built for; what the firmware has said is in the log. With the boot-arg
+ * wifi_scan=1 the station of lx_80211.c has the radio scan, and the driver is taken down again
+ * the way its own removal does it (ath10k_snoc_remove()); with wifi_join=1 the station joins the
+ * network the kernel was given, and the driver stays up, carrying the kernel's frames, until
+ * lx_stop().
+ *
+ * The kernel's boot-arg wifi_debug is the driver's own debug_mask: say what kinds of its things
+ * are to be said as they happen (a sum of the ATH10K_DBG_* of debug.h; 0, and only what the
+ * driver says with ath10k_err() and ath10k_warn() is said).
+ */
+#include <linux/kernel.h>
+#include <linux/ioport.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/clk.h>
+#include <linux/regulator/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/firmware.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/pwrseq/consumer.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/skbuff.h>
+
+#include "core.h"
+#include "snoc.h"
+#include "debug.h"
+
+#include <lx_os.h>
+#include "lx.h"
+
+/* ---- what the driver says ---------------------------------------------------------------------- */
+
+/* (the driver's own debug_mask: core.c has the variable, lx_start() takes it from wifi_debug) */
+
+static void
+driver_says(const char *format, va_list list)
+{
+	char line[320];
+	size_t length;
+
+	vsnprintf(line, sizeof(line), format, list);
+	length = strlen(line);
+	printf("ath10k: %s%s", line, length != 0 && line[length - 1] == '\n' ? "" : "\n");
+}
+
+static void
+says_v(const char *format, va_list list)
+{
+
+	driver_says(format, list);
+}
+
+static void __printf(1, 2)
+says(const char *format, ...)
+{
+	va_list list;
+
+	va_start(list, format);
+	says_v(format, list);
+	va_end(list);
+}
+
+static void
+says_about_v(struct ath10k *ar, const char *format, va_list list)
+{
+	char line[288];
+	size_t length;
+
+	if (ar == NULL) {
+		says_v(format, list);
+		return;
+	}
+	vsnprintf(line, sizeof(line), format, list);
+	length = strlen(line);
+	says("%s: %s%s", dev_name(ar->dev), line, length != 0 && line[length - 1] == '\n' ? "" : "\n");
+}
+
+void
+ath10k_info(struct ath10k *ar, const char *format, ...)
+{
+	va_list list;
+
+	va_start(list, format);
+	says_about_v(ar, format, list);
+	va_end(list);
+}
+
+void
+ath10k_err(struct ath10k *ar, const char *format, ...)
+{
+	va_list list;
+
+	va_start(list, format);
+	says_about_v(ar, format, list);
+	va_end(list);
+}
+
+void
+ath10k_warn(struct ath10k *ar, const char *format, ...)
+{
+	va_list list;
+
+	va_start(list, format);
+	says_about_v(ar, format, list);
+	va_end(list);
+}
+
+void
+__ath10k_dbg(struct ath10k *ar, enum ath10k_debug_mask mask, const char *format, ...)
+{
+	va_list list;
+
+	if ((ath10k_debug_mask & mask) == 0) {
+		return;
+	}
+	va_start(list, format);
+	says_about_v(ar, format, list);
+	va_end(list);
+}
+
+void
+ath10k_dbg_dump(struct ath10k *ar, enum ath10k_debug_mask mask, const char *message,
+    const char *prefix, const void *buffer, size_t length)
+{
+	size_t i;
+	unsigned j;
+
+	if ((ath10k_debug_mask & mask) == 0) {
+		return;
+	}
+	if (message != NULL && message[0] != '\0') {
+		says("%s (%lu bytes)", message, (unsigned long)length);
+	}
+	for (i = 0; i < length; i += 16) {
+		char line[72];
+		int n;
+
+		n = snprintf(line, sizeof(line), "%s%04lx:", prefix != NULL ? prefix : "", (unsigned long)i);
+		for (j = 0; j < 16 && i + j < length; j++) {
+			n += snprintf(line + n, sizeof(line) - n, "%s%02x", j == 8 ? "  " : " ",
+			    ((const unsigned char *)buffer)[i + j]);
+		}
+		printf("%s\n", line);
+	}
+}
+
+/* ---- what the driver's own table of this chip says --------------------------------------------- */
+
+/*
+ * snoc.c keeps its own table of the chips it knows in its probe: it is what
+ * device_get_match_data() is asked for. This is its entry for the WCN3990, as it is there.
+ */
+static const struct ath10k_snoc_drv_priv drv_priv_lx = {
+	.hw_rev = ATH10K_HW_WCN3990,
+	.dma_mask = DMA_BIT_MASK(35),
+	.msa_size = 0x100000,
+};
+
+const void *
+device_get_match_data(struct device *dev)
+{
+
+	return (&drv_priv_lx);
+}
+
+const void *
+of_device_get_match_data(struct device *dev)
+{
+
+	return (device_get_match_data(dev));
+}
+
+int
+device_property_read_u32(struct device *dev, const char *name, u32 *value)
+{
+	const void *property;
+	int length;
+
+	if (dev == NULL || dev->of_node == NULL ||
+	    (property = of_get_property(dev->of_node, name, &length)) == NULL ||
+	    length != (int)sizeof(u32)) {
+		return (-EINVAL);
+	}
+	*value = *(const u32 *)property;
+	return (0);
+}
+
+int
+device_property_read_string(struct device *dev, const char *name, const char **value)
+{
+	const void *property;
+
+	if (dev == NULL || dev->of_node == NULL ||
+	    (property = of_get_property(dev->of_node, name, NULL)) == NULL) {
+		return (-EINVAL);
+	}
+	*value = property;
+	return (0);
+}
+
+bool
+device_property_present(struct device *dev, const char *name)
+{
+
+	return (dev != NULL && dev->of_node != NULL &&
+	    of_find_property(dev->of_node, name, NULL) != NULL);
+}
+
+/* ---- the machine's word of the radio ----------------------------------------------------------- */
+
+/*
+ * The one thing the driver reads of the device's node is what it is ("qcom,wcn3990-wifi"): its
+ * calibration comes from its file (the machine's own, taken where lx_os_firmware() reads), for
+ * there is no one-time memory of the phone to ask.
+ */
+static const struct property radio_properties[] = {
+	{ .name = "compatible", .length = (int)sizeof("qcom,wcn3990-wifi"), .value = "qcom,wcn3990-wifi" },
+};
+
+static struct device_node radio_node = {
+	.name = "wifi",
+	.full_name = "wlan@18800000",
+	.properties = radio_properties,
+	.nproperties = (int)(sizeof(radio_properties) / sizeof(radio_properties[0])),
+};
+
+/*
+ * The radio's registers, in the SoC's map, as the table of the machine has them for the WCN3990
+ * (the node's one span, named "membase"), and its eleven interrupts, one for each copy engine,
+ * in the order the driver asks for them (the table of their names is in snoc.h). The kernel's
+ * vectors are what the driver's handlers are taken care on: the radio's line 0 is the kernel's
+ * vector 0, and so on.
+ */
+static struct resource radio_resources[] = {
+	{ .name = "membase", .start = 0x18800000, .end = 0x18800000 + 0x00800000 - 1,
+	  .flags = IORESOURCE_MEM },
+};
+
+static struct platform_device radio_platform_device;
+
+const struct property *
+of_find_property(const struct device_node *np, const char *name, int *lenp)
+{
+	int i;
+
+	if (np == NULL) {
+		return (NULL);
+	}
+	for (i = 0; i < np->nproperties; i++) {
+		if (strcmp(np->properties[i].name, name) == 0) {
+			if (lenp != NULL) {
+				*lenp = np->properties[i].length;
+			}
+			return (&np->properties[i]);
+		}
+	}
+	return (NULL);
+}
+
+const void *
+of_get_property(const struct device_node *np, const char *name, int *lenp)
+{
+	const struct property *property;
+
+	if ((property = of_find_property(np, name, lenp)) == NULL) {
+		return (NULL);
+	}
+	return (property->value);
+}
+
+bool
+of_device_is_compatible(const struct device_node *np, const char *compatible)
+{
+	const char *value;
+
+	if ((value = of_get_property(np, "compatible", NULL)) == NULL) {
+		return (false);
+	}
+	return (strcmp(value, compatible) == 0);
+}
+
+struct device_node *
+of_get_child_by_name(const struct device_node *np, const char *name)
+{
+
+	return (NULL);					/* (the radio's node has no children: nothing reads one) */
+}
+
+int
+of_property_read_string(const struct device_node *np, const char *name, const char **out)
+{
+	const void *property;
+
+	if (np == NULL || (property = of_get_property(np, name, NULL)) == NULL) {
+		return (-EINVAL);
+	}
+	*out = property;
+	return (0);
+}
+
+int
+of_property_read_string_index(const struct device_node *np, const char *name, int index,
+    const char **out)
+{
+	const void *property;
+	int length;
+
+	if (np == NULL || (property = of_get_property(np, name, &length)) == NULL ||
+	    length < (index + 1) * (int)sizeof(const char *)) {
+		return (-EINVAL);
+	}
+	*out = ((const char *const *)property)[index];
+	return (0);
+}
+
+const struct of_device_id *
+of_match_node(const struct of_device_id *matches, const struct device_node *np)
+{
+	const char *compatible;
+
+	if ((compatible = of_get_property(np, "compatible", NULL)) == NULL) {
+		return (NULL);
+	}
+	for (; matches->compatible[0] != '\0'; matches++) {
+		if (strcmp(matches->compatible, compatible) == 0) {
+			return (matches);
+		}
+	}
+	return (NULL);
+}
+
+int
+of_address_to_resource(const struct device_node *np, int index, struct resource *res)
+{
+
+	if (index != 0) {
+		return (-EINVAL);
+	}
+	*res = radio_resources[0];
+	return (0);
+}
+
+/*
+ * What else the driver reads of its node: the cells of a property, one at a time or as an array
+ * of bytes (the calibration's kind). What the node does not say is answered so.
+ */
+int
+of_property_read_u32_index(const struct device_node *np, const char *name, u32 index, u32 *out)
+{
+	const void *property;
+	int length;
+
+	if (np == NULL || (property = of_get_property(np, name, &length)) == NULL ||
+	    length < (int)((index + 1) * sizeof(u32))) {
+		return (-EINVAL);
+	}
+	*out = ((const u32 *)property)[index];
+	return (0);
+}
+
+int
+of_property_read_u8_array(const struct device_node *np, const char *name, u8 *out, size_t count)
+{
+	const void *property;
+	int length;
+
+	if (np == NULL || (property = of_get_property(np, name, &length)) == NULL ||
+	    length < (int)count) {
+		return (-EINVAL);
+	}
+	memcpy(out, property, count);
+	return (0);
+}
+
+/* ---- the platform device, as the machine would have said it ------------------------------------ */
+
+struct resource *
+platform_get_resource(struct platform_device *pdev, unsigned type, unsigned num)
+{
+	unsigned i;
+
+	for (i = 0; i < pdev->num_resources; i++) {
+		if ((pdev->resource[i].flags & type) != 0 && num-- == 0) {
+			return (&pdev->resource[i]);
+		}
+	}
+	return (NULL);
+}
+
+struct resource *
+platform_get_resource_byname(struct platform_device *pdev, unsigned type, const char *name)
+{
+	unsigned i;
+
+	for (i = 0; i < pdev->num_resources; i++) {
+		if ((pdev->resource[i].flags & type) != 0 && pdev->resource[i].name != NULL &&
+		    strcmp(pdev->resource[i].name, name) == 0) {
+			return (&pdev->resource[i]);
+		}
+	}
+	return (NULL);
+}
+
+int
+platform_get_irq(struct platform_device *pdev, unsigned num)
+{
+
+	if (num >= CE_COUNT_MAX) {
+		return (-ENXIO);
+	}
+	return ((int)num);
+}
+
+void
+platform_set_drvdata(struct platform_device *pdev, void *data)
+{
+
+	pdev->dev.driver_data = data;
+}
+
+void *
+platform_get_drvdata(struct platform_device *pdev)
+{
+
+	return (pdev->dev.driver_data);
+}
+
+/*
+ * The driver's own file says itself as a driver (its module_platform_driver()): its
+ * registration is kept here, for lx_start() to give its probe the device the way the bus
+ * would have.
+ */
+static struct platform_driver *radio_driver;
+
+int
+platform_driver_register(struct platform_driver *pdrv)
+{
+
+	radio_driver = pdrv;
+	return (0);
+}
+
+void
+platform_driver_unregister(struct platform_driver *pdrv)
+{
+
+	if (radio_driver == pdrv) {
+		radio_driver = NULL;
+	}
+}
+
+struct platform_device *
+platform_device_register_full(struct platform_device_info *info)
+{
+
+	return (ERR_PTR(-ENODEV));			/* (only the firmware's device is asked for, and there is none) */
+}
+
+/* ---- what the driver asks to keep as long as its device is there ------------------------------- */
+
+struct devres {
+	struct devres *next;
+	void (*release)(struct device *, void *);
+	size_t size;
+};
+
+#define DEVRES_OF(memory)	((struct devres *)((char *)memory - sizeof(struct devres)))
+
+static struct devres *radio_devres;			/* (there is one radio, and its memory with it) */
+
+static void
+devres_release_all(void)
+{
+	struct devres *devres, *next;
+
+	lx_os_lock();
+	devres = radio_devres;
+	radio_devres = NULL;
+	lx_os_unlock();
+	for (; devres != NULL; devres = next) {
+		next = devres->next;
+		if (devres->release != NULL) {
+			(devres->release)(NULL, (char *)devres + sizeof(*devres));
+		}
+		lx_os_free(devres, sizeof(*devres) + devres->size);
+	}
+}
+
+void *
+lkpi_devres_alloc(void (*release)(struct device *, void *), size_t size, gfp_t flags)
+{
+	struct devres *devres;
+
+	if ((devres = lx_os_alloc(sizeof(*devres) + size)) == NULL) {
+		return (NULL);
+	}
+	devres->release = release;
+	devres->size = size;
+	return ((char *)devres + sizeof(*devres));
+}
+
+void
+lkpi_devres_add(struct device *dev, void *memory)
+{
+	struct devres *devres = DEVRES_OF(memory);
+
+	lx_os_lock();
+	devres->next = radio_devres;
+	radio_devres = devres;
+	lx_os_unlock();
+}
+
+void
+lkpi_devres_free(void *memory)
+{
+	struct devres *devres;
+
+	if (memory == NULL) {
+		return;
+	}
+	devres = DEVRES_OF(memory);
+	lx_os_free(devres, sizeof(*devres) + devres->size);
+}
+
+void *
+lkpi_devres_find(struct device *dev, void (*release)(struct device *, void *),
+    int (*match)(struct device *, void *, void *), void *match_data)
+{
+	struct devres *devres;
+
+	lx_os_lock();
+	for (devres = radio_devres; devres != NULL; devres = devres->next) {
+		if (devres->release == release &&
+		    (match == NULL || (match)(NULL, (char *)devres + sizeof(*devres), match_data))) {
+			lx_os_unlock();
+			return ((char *)devres + sizeof(*devres));
+		}
+	}
+	lx_os_unlock();
+	return (NULL);
+}
+
+int
+lkpi_devres_destroy(struct device *dev, void (*release)(struct device *, void *),
+    int (*match)(struct device *, void *, void *), void *match_data)
+{
+	struct devres **devresp, *devres;
+
+	lx_os_lock();
+	for (devresp = &radio_devres; (devres = *devresp) != NULL; devresp = &devres->next) {
+		if (devres->release == release &&
+		    (match == NULL || (match)(NULL, (char *)devres + sizeof(*devres), match_data))) {
+			*devresp = devres->next;
+			lx_os_unlock();
+			if (release != NULL) {
+				(release)(NULL, (char *)devres + sizeof(*devres));
+			}
+			lx_os_free(devres, sizeof(*devres) + devres->size);
+			return (1);
+		}
+	}
+	lx_os_unlock();
+	return (0);
+}
+
+/*
+ * The driver's memory that lives as long as its device does is devm_kmalloc()'s, which the
+ * device's header keeps in its own list: what is asked for here is only the freeing of it,
+ * where the driver gives a piece back before its device goes, and the no-op that the memory
+ * is not done anything with when the device does.
+ */
+void
+lkpi_devm_kmalloc_release(struct device *dev, void *memory)
+{
+}
+
+void
+lkpi_devm_kfree(struct device *dev, const void *memory)
+{
+	struct devres **devresp, *devres;
+
+	if (memory == NULL) {
+		return;
+	}
+	lx_os_lock();
+	for (devresp = &radio_devres; (devres = *devresp) != NULL; devresp = &devres->next) {
+		if ((char *)devres + sizeof(*devres) == memory) {
+			*devresp = devres->next;
+			lx_os_unlock();
+			lx_os_free(devres, sizeof(*devres) + devres->size);
