--- /dev/null
+++ b/xnu/files/bsd/dev/redwood_pcie.c
@@ -0,0 +1,912 @@
+/*
+ * The PCIe root complex of the OnePlus 6 (sdm845), on which the phone's Wi-Fi lives: a
+ * Qualcomm WCN3990, a radio that does not sit behind any DSP -- the host talks to it over
+ * PCIe and loads its firmware itself. Everything below was learned from the phone's Android
+ * device tree, the mainline Qualcomm PCIe driver (drivers/pci/controller/dwc/pcie-qcom.c,
+ * the ops for the "1.9.0" hardware, which is what this controller is) and its QMP v3 PHY
+ * driver (drivers/phy/qualcomm/phy-qcom-qmp-pcie.c, sdm845 tables) -- and, in the
+ * vendor device tree, the PHY's init sequence written out as raw register writes, which
+ * matches the mainline tables value for value.
+ *
+ * Hardware (the device tree's numbers; the address of the PCIe block):
+ *
+ *   parf      0x1c00000       the Qualcomm side of the controller ("PARF", 8 KiB)
+ *   PHY       0x1c06000       a QMP v3 serdes/tx/rx/pcs/pcs_misc lane, 4 KiB
+ *   dm_core   0x60000000      the controller's own (DesignWare) config space, "dbi"
+ *   elbi      0x60000f20      its interrupt block ("elbi"), inside the same page
+ *   conf      0x60100000      1 MiB of config space at (bus << 20 | dev << 15 | fn << 12)
+ *   io        0x60200000      (not used here)
+ *   bars      0x60300000, 13 MiB   (not used here)
+ *   perst     GPIO 35, wake GPIO 37 (both on the TLMM's south tile; the GPIO drives
+ *             the device's PERST# through the board's buffer: HIGH holds the device
+ *             in reset, and the device starts link training when it goes LOW -- which
+ *             is how the mainline driver with this device tree's "perst-gpio" flag
+ *             behaves: it drives the line HIGH through the bring-up and LOW 100 ms
+ *             before the link is asked to train)
+ *   supplies  from the PM8998, asked for by vote in RPMh by name: 1.2 V from "ldoa26",
+ *             0.88 V from "ldoa1" (the device tree's vreg-1.8 / vreg-0.9 -- the PCIe
+ *             lane's analog supply and the PHY's digital one); the system's "cx" arc
+ *             is left to the boot loader, as it is everywhere else here
+ *   clocks    the GCC block: a GDSC ("pcie_0"), six clock-enable votes, five clock
+ *             gates, two RCGs (the PHY's 19.2 MHz "aux" from the tcxo, the PHY's
+ *             "refgen" at 100 MHz from GPLL0), a "clkref" gate and three resets
+ *             (the address of every one below was cross-checked against the
+ *             downstream clock driver's definitions for the same registers)
+ *   MSI       the GICv2m frame at 0x17a00040, SPI 704.. -- not wired yet (a later step)
+ *   SMMU      the radio's DMA flows have sids 0x1c10.. -- not touched yet either: with
+ *             the device tree's iommu-map, bus 0-15 device 0 map to sid 0x1c10 + bus,
+ *             and the translation table here is programmed accordingly (but flows
+ *             only start once the radio asks for its memory)
+ *
+ * The bring-up is one step after another, in the mainline driver's order:
+ *
+ *   1  mapped        the blocks mapped (a look, no reads yet)
+ *   2  probe tlmm    the pins read, known safe ground
+ *   3  perst         the device held in reset (GPIO 35 HIGH) through the whole bring-up
+ *   4  probe gcc     the clock block read AS FOUND (it has no gate of its own): whether the
+ *                    domain was left on, and what its votes were
+ *   5  supplies      ldoa26 to 1.2 V and ldoa1 to 0.88 V, both HPM, one RPMh write at a time
+ *   6  clocks        both RCGs, the GDSC on, the six votes on, every gate polled to open,
+ *                    the "clkref" gate on
+ *   7  resets        the controller's core and PHY reset, 1 ms each way
+ *   8-11  probe ...  parf, dbi, conf, the PHY read one step each -- ONLY NOW, powered and
+ *                    clocked (a cold block's read can hang the bus; every register named in
+ *                    the log before its read goes, so a trapped read is not anonymous)
+ *   12 parf          the mainline init sequence of the 1.9.0 controller (its registers,
+ *                    from DEVICE_TYPE to the AXI master's write-halt)
+ *   13 phy           the QMP v3 lane: tables in, reset out, started, "PHYSTATUS" waited to
+ *                    clear
+ *   14 perst         the device let go (100 ms held first, then LOW, 1 ms, as the driver has
+ *                    it)
+ *   15 sid           the SMMU translation table filled: every bus's device 0 to its sid, the
+ *                    table's BDF hash and all, and translation turned on
+ *   16 ltssm         equalization left alone (the device tree's hardware does its own), the
+ *                    link asked to train, then "Data Link Layer Link Active" waited for,
+ *                    one second
+ *   17 enumerate     the config space at (0,0,0) read out -- the radio answers there (the
+ *                    vendor kernel's "boot option 1": a transparent root, the endpoint in
+ *                    the same 1 MiB window), and this step looks for vendor 0x17cb device
+ *                    0x1101
+ *
+ * The order the driver works in: every step prints what it does and what it read, and
+ * stops the bring-up when it did not get what it expected.
+ *
+ * Boot-args:
+ *
+ *   pcie=1         run the bring-up (nothing below this driver happens without it)
+ *   pcie_step=N    stop after step N (for finding the step that kills a run)
+ *   pcie_slow=1    8 s between the steps (runs die faster than the host reads the log;
+ *                  the gaps let every line through -- the touch screen's driver's trick)
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern boolean_t ml_get_interrupts_enabled(void);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static uint32_t level;
+static bool leaving;
+static unsigned step_number, step_limit, slow;
+
+/* every line to the loader's log as well (and to the console when that may be written) */
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	if (!leaving && ml_get_interrupts_enabled()) {
+		printf("%s", line);
+	}
+	return length;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+/* one step of the bring-up; false = a later step was asked for instead */
+static bool
+step(const char *what)
+{
+	step_number++;
+	if (step_limit != 0 && step_number > step_limit) {
+		return false;
+	}
+	say("pcie: step %u: %s\n", step_number, what);
+	if (slow) {
+		say("pcie: -- step %s done, sleeping 8 s --\n", what);
+		wait_ms(8000);
+	}
+	return true;
+}
+
+/* a register named for a step's failure line */
+static void
+show(const char *what, vm_offset_t address)
+{
+	say("pcie: %s at %lx reads %#x\n", what, address, rd(address));
+}
+
+static bool
+poll32(vm_offset_t address, uint32_t mask, uint32_t want, uint32_t ms, const char *what)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if ((rd(address) & mask) == want) {
+			return true;
+		}
+		spin_us(100);
+	}
+	say("pcie: TIMEOUT waiting for %s (register %lx: %#x wanted %#x)\n", what, address, rd(address), want);
+	return false;
+}
+
+/* ---- the blocks ------------------------------------------------------------------------------------- */
+
+/* the GCC block: the addresses of everything this driver touches, as the downstream clock
+ * driver spells them (its base is the middle of the sdm845's clock tree at 0x100000) */
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x001f0000UL
+#define GCC(reg)                (gcc + (reg) - 0x100000UL)
+
+#define GCC_PCIE_0_GDSCR        0x16b004        /* bit 0 "collapse" clear = on; +4: bit 16 "up" */
+#define GCC_PCIE_0_BCR          0x16b000
+#define GCC_PCIE_0_AUX_CLK_CMD  0x16b028        /* an RCG: bit 31 update; its config is at +0x14 */
+#define GCC_PCIE_0_AUX_CLK_CFG  0x16b03c
+#define GCC_PCIE_0_Q2A_HALT     0x16b00c
+#define GCC_PCIE_0_SLV_HALT     0x16b010
+#define GCC_PCIE_0_MSTR_HALT    0x16b014
+#define GCC_PCIE_0_CFG_HALT     0x16b018
+#define GCC_PCIE_0_AUX_HALT     0x16b01c        /* bit 31 = the clock is off */
+#define GCC_PCIE_0_PHY_BCR      0x16c01c
+#define GCC_PCIE_PHY_REFGEN_CMD 0x16f014
+#define GCC_PCIE_PHY_REFGEN_CFG 0x16f028
+#define GCC_PCIE_PHY_AUX_HALT   0x16f004        /* also its gate enable, bit 0 */
+#define GCC_PCIE_PHY_REFGEN_HALT 0x16f02c       /* ... and its gate enable, bit 0 */
+#define GCC_PCIE_0_CLKREF_EN    0x18c00c        /* bit 0 enable, bit 31 halt (self-gating) */
+#define GCC_PCIE_0_CLK_VOTE     0x15200c        /* the six enable votes, bit 0..5 */
+#define GCC_VOTE_SLV_AXI        (1u << 0)
+#define GCC_VOTE_MSTR_AXI       (1u << 1)
+#define GCC_VOTE_CFG_AHB        (1u << 2)
+#define GCC_VOTE_AUX            (1u << 3)
+#define GCC_VOTE_PIPE           (1u << 4)
+#define GCC_VOTE_SLV_Q2A        (1u << 5)
+#define GCC_RCG_UPDATE          (1u << 31)
+/* config words for the two RCGs: source (bits 10:8) and pre-divided-by (bits 15:12, minus one) */
+#define AUX_CFG_TCXO_19_2MHZ    0x00000000u     /* source 0 = the tcxo, division 1: 19.2 MHz */
+#define REFGEN_CFG_GPLL0_100MHZ 0x00005100u     /* source 1 = gpll0, divide 6: 100 MHz */
+
+#define PARF_PHYS               0x01c00000UL
+#define PARF_SIZE               0x2000UL
+#define PARF(reg)               (parf + (reg))
+#define PARF_SYS_CTRL           0x00            /* bit 29: MAC PHY powerdown in P2 multiplexed */
+#define PARF_PM_CTRL            0x20            /* bit 5: "not entry L1 request" */
+#define PARF_PHY_CTRL           0x40            /* bit 0: the PHY held in test power down */
+#define PARF_LTSSM_STATE        0x1b0           /* bit 8 = "start"; the state in bits 5:0 */
+#define PARF_MHI_CLOCK_RESET    0x174           /* bit 4: the MHI clock bypassed (not from an MHI side) */
+#define PARF_AXI_MSTR_WR_HALT   0x1a8           /* bit 31: the write halt feature on */
+#define PARF_DBI_BASE_V2        0x350           /* the controller's own config space, split in two */
+#define PARF_DBI_BASE_HI_V2     0x354
+#define PARF_SLV_SPACE_V2       0x358           /* where its own config space ends, the bars' base */
+#define PARF_SLV_SPACE_HI_V2    0x35c
+#define PARF_BDF_TO_SID_CFG     0x2c00          /* bit 0: translation on */
+#define PARF_BDF_TO_SID_TABLE   0x2000          /* 256 entries: bdf | sid << 8 | next << 24 */
+#define PARF_DEVICE_TYPE        0x1000          /* 4 = a root port */
+#define MAC_PHY_POWERDOWN_IN_P2_D_MUX_EN        (1u << 29)
+#define REQ_NOT_ENTR_L1         (1u << 5)
+#define PHY_TEST_PWR_DOWN       (1u << 0)
+#define MHI_CLOCK_BYPASS        (1u << 4)
+#define AXI_MSTR_WR_ADDR_HALT_EN (1u << 31)
+#define LTSSM_ENABLE            (1u << 8)
+
+#define DM_CORE_PHYS            0x60000000UL    /* the controller's own (DesignWare) config space */
+#define DM_CORE_SIZE            0x1000UL
+#define DBI(reg)                (dbi + (reg))
+
+#define CONF_PHYS               0x60100000UL    /* (bus << 20 | dev << 15 | fn << 12), 1 MiB: bus 0 */
+#define CONF_SIZE               0x100000UL
+#define CONF(bdf, off)          (conf + ((uint64_t)(bdf) << 20 | (off)))
+
+#define PHY_PHYS                0x01c06000UL    /* the QMP v3 lane */
+#define PHY_SIZE                0x1000UL
+#define SERDES(off)             (phy + (off))
+#define TXRX(off)               (phy + 0x200UL + (off))
+#define PCS(off)                (phy + 0x800UL + (off))
+#define PCS_MISC(off)           (phy + 0x600UL + (off))
+#define PCS_POWER_DOWN_CONTROL  0x004
+#define PCS_START_CONTROL       0x008
+#define PCS_SW_RESET            0x000
+#define PCS_STATUS              0x174
+#define PHYSTATUS               (1u << 6)
+#define SW_PWRDN                (1u << 0)
+#define REFCLK_DRV_DSBL         (1u << 1)
+#define SERDES_START            (1u << 1)
+#define PCS_START_              (1u << 0)
+#define SW_RESET_               (1u << 0)
+
+/* the pins: GPIO 35 is the device's reset, GPIO 37 its wake -- both on the south tile (the
+ * tile logic as the touch screen's driver has it: the pin's GLOBAL number into the tile) */
+#define TLMM_SOUTH_PHYS         0x03d00000UL
+#define TLMM_SOUTH_SIZE         0x80000UL
+#define GPIO_CFG(pin)           (tlmm_south + 0x1000UL * (pin))
+#define GPIO_IO(pin)            (GPIO_CFG(pin) + 4)
+#define CFG_OUTPUT              (1u << 9)
+#define PIN_PERST               35
+#define PIN_WAKE                37
+
+static vm_offset_t gcc, parf, dbi, conf, phy, tlmm_south;
+
+/* ---- RPMh (the supplies), the way every driver on this phone does it -------------------------------- */
+
+#define CMD_DB_SCRATCH_PHYS     0x0c3f000cUL    /* holds the address of the command database */
+#define CMD_DB_SIZE             0x20000UL
+
+#define RSC_PHYS                0x179e0000UL    /* the application processor's "DRV 2" of the RSC at 0x179c0000 */
+#define RSC_SIZE                0x10000UL
+#define TCS(reg)                (rsc + 0xd00 + (reg))
+#define TCS_IRQ_ENABLE          0x00
+#define TCS_IRQ_STATUS          0x04
+#define TCS_IRQ_CLEAR           0x08
+#define TCS_WAIT_FOR_COMPLETION 0x10
+#define TCS_CONTROL             0x14
+#define TCS_CONTROL_ENABLE      (1u << 16)
+#define TCS_CONTROL_TRIGGER     (1u << 24)
+#define TCS_STATUS              0x18
+#define TCS_CMD_ENABLE          0x1c
+#define TCS_CMD_MSGID(n)        (0x30 + 20 * (n))
+#define TCS_CMD_ADDR(n)         (0x34 + 20 * (n))
+#define TCS_CMD_DATA(n)         (0x38 + 20 * (n))
+#define MSGID_WRITE_4_BYTES     0x10008
+#define MSGID_RESPONSE          0x100
+
+#define VRM_VOLTAGE             0               /* a regulator's registers, from its address: millivolts */
+#define VRM_ENABLE              4
+#define VRM_MODE                8
+#define VRM_MODE_LDO_HPM        3
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static vm_offset_t rsc, cmd_db;
+
+static uint32_t
+rpmh_address(const char *name)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)cmd_db;
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		say("pcie: no command database (magic %02x %02x %02x %02x)\n", db->magic[0], db->magic[1], db->magic[2],
+		    db->magic[3]);
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+static bool
+rpmh_wait(uint32_t reg, uint32_t mask, uint32_t value, const char *what)
+{
+	for (int i = 0; i < 2000; i++) {
+		if ((rd(TCS(reg)) & mask) == value) {
+			return true;
+		}
+		spin_us(100);
+	}
+	say("pcie: RPMh: timeout waiting for %s (register %#x = %#x)\n", what, reg, rd(TCS(reg)));
+	return false;
+}
+
+/* ONE register write to RPMh, waited out (see the touch screen's driver for why one at a time) */
+static bool
+rpmh_write(uint32_t address, uint32_t data, const char *what)
+{
+	uint32_t irq_enable = rd(TCS(TCS_IRQ_ENABLE));
+	bool done;
+
+	for (int i = 0; rd(TCS(TCS_STATUS)) == 0; i++) {
+		if (i > 2000) {
+			say("pcie: RPMh: the command slots stay busy\n");
+			return false;
+		}
+		spin_us(100);
+	}
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	wr(TCS(TCS_CMD_MSGID(0)), MSGID_WRITE_4_BYTES | MSGID_RESPONSE);
+	wr(TCS(TCS_CMD_ADDR(0)), address);
+	wr(TCS(TCS_CMD_DATA(0)), data);
+	wr(TCS(TCS_WAIT_FOR_COMPLETION), 1);
+	wr(TCS(TCS_CMD_ENABLE), 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable | 1);
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE | TCS_CONTROL_TRIGGER);
+
+	done = rpmh_wait(TCS_IRQ_STATUS, 1, 1, what);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_CMD_ENABLE), 0);
+	wr(TCS(TCS_WAIT_FOR_COMPLETION), 0);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable);
+	return done;
+}
+
+/*
+ * A regulator by its name in the command database: voltage, mode, enable, in that order,
+ * one write at a time. The resources are spelled with the PMIC's letter ("ldoa26" is the
+ * PM8998's LDO 26); "ldo26" is asked for too, as the touch screen's driver does.
+ */
+static bool
+rpmh_regulator(const char *name, uint32_t mv, const char *label)
+{
+	uint32_t base = rpmh_address(name);
+
+	if (base == 0) {
+		char short_name[8] = { 0 };
+
+		if (name[0] == 'l' && name[1] == 'd' && name[2] == 'o' && name[3] == 'a' && strlen(name) < 7) {
+			strlcpy(short_name, "ldo", sizeof(short_name));
+			strlcat(short_name, name + 4, sizeof(short_name));
+			base = rpmh_address(short_name);
+		}
+		if (base == 0) {
+			say("pcie: RPMh: no regulator \"%s\" for %s\n", name, label);
+			return false;
+		}
+	}
+	if ((base >> 16 & 0xf) != 4) {
+		say("pcie: RPMh: \"%s\" is not a regulator (address %#x): %s NOT touched\n", name, base, label);
+		return false;
+	}
+	say("pcie: RPMh: %s is \"%s\" at %#x, asked for %u uV\n", label, name, base, mv);
+	if (!rpmh_write(base + VRM_VOLTAGE, mv, label)) {
+		return false;
+	}
+	if (!rpmh_write(base + VRM_MODE, VRM_MODE_LDO_HPM, label)) {
+		return false;
+	}
+	if (!rpmh_write(base + VRM_ENABLE, 1, label)) {
+		return false;
+	}
+	say("pcie: the %s supply is on (%s, %u uV, HPM)\n", label, name, mv);
+	return true;
+}
+
+/* ---- the QMP v3 lane's tables (the mainline sdm845 ones, which the phone's own device
+ * tree writes out value for value) ---------------------------------------------------------------------- */
+
