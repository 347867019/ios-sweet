+static void
+qmp_write(vm_offset_t base, const struct qmp_table *table, unsigned count)
+{
+	for (unsigned i = 0; i < count; i++) {
+		wr(base + table[i].offset, table[i].value);
+	}
+}
+
+/* ---- the SMMU's BDF-to-sid table ---------------------------------------------------------------------- */
+
+/* the table entry's hash: a CRC8 over the BDF's two bytes, most significant bit first */
+static uint8_t
+bdf_crc8(uint32_t bdf)
+{
+	uint8_t crc = 0;
+
+	for (int byte = 1; byte >= 0; byte--) {
+		crc ^= (bdf >> (8 * byte)) & 0xff;
+		for (int bit = 0; bit < 8; bit++) {
+			crc = (crc & 0x80) ? (uint8_t)(crc << 1 ^ 0x07) : (uint8_t)(crc << 1);
+		}
+	}
+	return crc;
+}
+
+/*
+ * The device tree maps every bus's device 0 to a sid ("iommu-map" of 16 entries: sid 0x1c10
+ * + bus). The translation table answers with the sid of the traffic's BDF; the table is
+ * chained where two BDFs hash to one slot, the way the mainline driver chains them.
+ */
+static void
+sid_table_program(void)
+{
+	static const uint32_t base_sid = 0x1c10;
+
+	for (unsigned i = 0; i < 256; i++) {
+		wr(PARF(PARF_BDF_TO_SID_TABLE + 4 * i), 0);
+	}
+	for (unsigned bus = 0; bus < 16; bus++) {
+		uint32_t bdf = bus << 8;
+		uint32_t hash = bdf_crc8(bdf);
+		uint32_t back, val = bdf << 16 | bus << 8;      /* the sid offset from the map's base */
+		while ((back = rd(PARF(PARF_BDF_TO_SID_TABLE + 4 * hash))) != 0) {
+			if (!(back & 0xff)) {
+				back |= (hash + 1) % 256;
+				wr(PARF(PARF_BDF_TO_SID_TABLE + 4 * hash), back);
+			}
+			hash = (hash + 1) % 256;
+		}
+		wr(PARF(PARF_BDF_TO_SID_TABLE + 4 * hash), val);
+		say("pcie: sid table: bdf %#x -> sid %#x (slot %u)\n", bdf, base_sid + bus, hash);
+	}
+}
+
+/* ---- the link ----------------------------------------------------------------------------------------- */
+
+/* the controller's own PCIe capability, for the link's status */
+static uint32_t
+pcie_cap(void)
+{
+	uint32_t pointer = rd(DBI(0x34)) & 0xff;
+
+	for (unsigned hops = 0; pointer != 0 && hops < 16; hops++) {
+		uint32_t cap = rd(DBI(pointer));
+
+		if ((cap & 0xff) == 0x10) {
+			return pointer;
+		}
+		pointer = (cap >> 8) & 0xff;
+	}
+	return 0;
+}
+
+static void
+show_link(const char *when)
+{
+	uint32_t cap = pcie_cap(), lnksta = 0;
+
+	if (cap != 0) {
+		lnksta = rd(DBI(cap + 0x10)) >> 16;
+	}
+	say("pcie: %s: LNKSTA %#04x (speed %u, width %u), DLLLA %u, LTSSM state %u\n", when, lnksta,
+	    lnksta & 0xf, (lnksta >> 4) & 0x1f, !!(lnksta & 1u << 16), rd(PARF(PARF_LTSSM_STATE)) & 0x3f);
+}
+
+/* ---- the steps ---------------------------------------------------------------------------------------- */
+
+/* one register, named before and after the read: a trapped read must leave the log saying
+ * WHICH register was its last (the touch screen's driver's lesson, for reads -- the runs
+ * of Oct 26: the first survey printed nothing, because every read happened before any line
+ * could go out, and the phone went to EDL with the killer anonymous) */
+static uint32_t
+probe(vm_offset_t address, const char *name)
+{
+	uint32_t value;
+
+	say("pcie: read %s at %lx\n", name, address);
+	value = rd(address);
+	say("pcie: read %s = %#x\n", name, value);
+	return value;
+}
+
+/* the six blocks, one step each, read only */
+static void
+probe_tlmm(void)
+{
+	probe(GPIO_CFG(PIN_PERST), "gpio35 cfg");
+	probe(GPIO_IO(PIN_PERST), "gpio35 io");
+	probe(GPIO_CFG(PIN_WAKE), "gpio37 cfg");
+	probe(GPIO_IO(PIN_WAKE), "gpio37 io");
+}
+
+static void
+probe_dbi(void)
+{
+	probe(DBI(0x00), "dbi vendor/device");
+	probe(DBI(0x08), "dbi class");
+	probe(DBI(0x34), "dbi cap pointer");
+	uint32_t cap = pcie_cap();
+
+	if (cap != 0) {
+		probe(DBI(cap + 0xc), "dbi LNKCAP");
+		probe(DBI(cap + 0x10), "dbi LNKCTL/STA");
+	}
+}
